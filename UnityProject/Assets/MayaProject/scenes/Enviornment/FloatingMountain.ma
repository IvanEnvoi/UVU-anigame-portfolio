createNode polyNormal -name "polyNormal2";
	rename -uuid "9974070E-4300-00E9-9664-ADBC195DAE28";
	setAttr ".inputComponents" -type "componentList" 1 "f[*]";
	setAttr ".userNormalMode" no;
