//function for each operatior
//1 arg
//calculate all args
///return
//sum diff multi div power mean median

global proc float math_sum(float $input[])
{
    float $result = 0;
    for ($i = 0; $i < size($input); $i++)
    {
        $result += $input[$i];
    }
    return $result;
}

global proc float math_multi(float $input[])
{
    if (size($input) == 0) return 0;
    float $result = 1;
    for ($i = 0; $i < size($input); $i++)
    {
        $result *= $input[$i];
    }
    return $result;
}

global proc float math_div(float $input[])
{
    if (size($input) == 0) return 0;
    float $result = $input[0];
    for ($i = 1; $i < size($input); $i++)
    {
        if ($input[$i] == 0)
        {
            warning("Division by zero encountered in math_div.");
            return 0;
        }
        $result /= $input[$i];
    }
    return $result;
}

global proc float math_diff(float $input[])
{
    if (size($input) == 0) return 0;
    float $result = $input[0];
    for ($i = 1; $i < size($input); $i++)
    {
        $result -= $input[$i];
    }
    return $result;
}

global proc float math_mean(float $input[])
{
    int $size = size($input);
    if ($size == 0) return 0;
    float $sum = 0;
    for ($i = 0; $i < $size; $i++)
    {
        $sum += $input[$i];
    }
    return $sum / $size;
}
global proc float math_power(float $input[])
{
    int $size = size($input);
    if ($size == 0) return 0;
    float $result = $input[0];
    for ($i = 1; $i < $size; $i++)
    {
        $result = pow($result, $input[$i]);
    }
    return $result;
}

global proc float math_median(float $input[])
{
    int $size = size($input);
    if ($size == 0) return 0;
    // Copy input to a new array for sorting
    float $sorted[];
    for ($i = 0; $i < $size; $i++)
    {
        $sorted[$i] = $input[$i];
    }
    // Bubble sort
    for ($i = 0; $i < $size - 1; $i++)
    {
        for ($j = 0; $j < $size - $i - 1; $j++)
        {
            if ($sorted[$j] > $sorted[$j + 1])
            {
                float $temp = $sorted[$j];
                $sorted[$j] = $sorted[$j + 1];
                $sorted[$j + 1] = $temp;
            }
        }
    }
    if ($size % 2 == 0)
    {
        // Even number of elements
        return ($sorted[$size / 2 - 1] + $sorted[$size / 2]) / 2.0;
    }
    else
    {
        // Odd number of elements
        return $sorted[(int)floor($size / 2)];
    }
}

// calculator: Calls a math function ("sum", "diff", etc.) on an array of floats and prints the result.
// Parameters:
//   $funct - The name of the math function to use ("sum", "diff", etc.).
//   $arry  - The array of float values to process.
global proc calculator(string $funct, float $arry[])
{
    string $expr = "";
    float $result = 0;
    int $size = size($arry);

    if ($size == 0)
    {
        print("No numbers provided.\n");
        return;
    }

    if ($funct == "sum")
    {
        for ($i = 0; $i < $size; $i++)
        {
            $expr += $arry[$i];
            if ($i < $size - 1) $expr += " + ";
        }
        $result = math_sum($arry);
        print($expr + " = " + $result + "\n");
    }
    else if ($funct == "diff")
    {
        for ($i = 0; $i < $size; $i++)
        {
            $expr += $arry[$i];
            if ($i < $size - 1) $expr += " - ";
        }
        $result = math_diff($arry);
        print($expr + " = " + $result + "\n");
    }
    else if ($funct == "multi")
    {
        for ($i = 0; $i < $size; $i++)
        {
            $expr += $arry[$i];
            if ($i < $size - 1) $expr += " * ";
        }
        $result = math_multi($arry);
        print($expr + " = " + $result + "\n");
    }
    else if ($funct == "div")
    {
        for ($i = 0; $i < $size; $i++)
        {
            $expr += $arry[$i];
            if ($i < $size - 1) $expr += " / ";
        }
        $result = math_div($arry);
        print($expr + " = " + $result + "\n");
    }
    else if ($funct == "power")
    {
        for ($i = 0; $i < $size; $i++)
        {
            $expr += $arry[$i];
            if ($i < $size - 1) $expr += " ^ ";
        }
        $result = math_power($arry);
        print($expr + " = " + $result + "\n");
    }
    else if ($funct == "mean" || $funct == "avg")
    {
        for ($i = 0; $i < $size; $i++)
        {
            $expr += $arry[$i];
            if ($i < $size - 1) $expr += ", ";
        }
        $result = math_mean($arry);
        print("mean(" + $expr + ") = " + $result + "\n");
    }
    else if ($funct == "median")
    {
        for ($i = 0; $i < $size; $i++)
        {
            $expr += $arry[$i];
            if ($i < $size - 1) $expr += ", ";
        }
        $result = math_median($arry);
        print("median(" + $expr + ") = " + $result + "\n");
    }
    else
    {
        print("Function not recognized\n");
    }
}

// Simplified calculator function that directly prints results without detailed expressions
global proc calculator_simple(string $funct, float $arry[])
{
    if ($funct == "sum")
    {
        print("Sum: " + math_sum($arry) + "\n");
    }
    else if ($funct == "diff")
    {
        print("diff: " + math_diff($arry) + "\n");
    }
    else if ($funct == "median")
    {
        print("median: " + math_median($arry) + "\n");
    }
    else if ($funct == "multi")
    {
        print("multi: " + math_multi($arry) + "\n");
    }
    else if ($funct == "div")
    {
        print("div: " + math_div($arry) + "\n");
    }
    else if ($funct == "power")
    {
        print("power: " + math_power($arry) + "\n");
    }
    else if ($funct == "mean" || $funct == "avg")
    {
        print("mean: " + math_mean($arry) + "\n");
    }
    else
    {
        print("Function not recognized\n");
    }
}


global proc Calc()
{
    string $calcwindow = `window -title "Calculator" -widthHeight 300 200`;
    gridLayout -numberOfColumns 2 -cellWidthHeight 150 30;
    text -label "Operation:";
    string $operation = `textField -text "sum" operation;
    text -label "Numbers (comma separated):";
    string $operation = `textField -text "3,2,5,1,4" args;
    string $operation = `textField operation;
    string $args = `textField args;
    button -label "Calculate" -command ("CalculateResult(\"" + $operation + "\", \"" + $args + "\")");
    text -label "Result:";

    showWindow $calcwindow;
    gridLayout -edit -numberOfColumns 2;

}

global proc CalculateResult(string $op string $args)
{
    string $opfield = `textField -query -text $op`;
    string $argsfield = `textField -query -text $args`;
    string $argArray[] = stringToStringArray($args, ",");
    float $numArray[];
    for ($arg in $argArray)
    {
        $numArray[size($numArray)] = (float)$arg;
    }
    calculator($op, $numArray);
    print("Result: " + $result + "\n");
}



// Example usage:
calculator("sum", {3, 2, 5, 1, 4});
calculator("median", {3, 2, 5, 1, 4});
calculator("diff", {3, 2, 5, 1, 4});
calculator("avg", {3, 2, 5, 1, 4});
calculator("multi", {3, 2, 5, 1, 4});
calculator("div", {3, 2, 5, 1, 4});
calculator("power", {3, 2, 5, 1, 4});
calculator("mean", {3, 2, 5, 1, 4});
// End of calculator.mel