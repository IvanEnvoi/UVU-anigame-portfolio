/* ============================
   Snowman Builder in MEL
   ============================
   - Creates body spheres
   - Adds scarf (optional)
   - Adds coal eyes & mouth
   - Supports scaling & positioning
   ============================ */

global proc string makeSnowman(string $name, float $scale, int $useScarf, float $posX, float $posY, float $posZ) {

    // ---------------------------
    // Create Snowman Body
    // ---------------------------
    string $bottom[] = `polySphere -r 3 -name ($name + "_bottom")`;
    move -r 0 0 0 $bottom[0];

    string $middle[] = `polySphere -r 2 -name ($name + "_middle")`;
    move -r 0 3.5 0 $middle[0];

    string $head[] = `polySphere -r 1.3 -name ($name + "_head")`;
    move -r 0 6 0 $head[0];

    // ---------------------------
    // Create Coal Face
    // ---------------------------
    string $coalGrp = `group -em -name ($name + "_coalFace")`;

    for ($i = 0; $i < 7; $i++) {
        string $coal[] = `polySphere -r 0.2 -sx 8 -sy 8 -name ($name + "_coal" + $i)`;

        if ($i < 2) {
            // Eyes
            move -a ((-0.4 + ($i * 0.8))) 6.8 1.0 $coal[0];
        } else {
            // Mouth pieces
            float $mouthX[] = {-0.8, -0.4, 0.0, 0.4, 0.8};
            float $mouthY[] = {6.2, 6.1, 6.0, 6.1, 6.2};
            move -a $mouthX[$i-2] $mouthY[$i-2] 0.7 $coal[0];
            scale -r 0.8 0.8 0.8 $coal[0];
        }

        parent $coal[0] $coalGrp;
    }

    // ---------------------------
    // Optional Scarf
    // ---------------------------
    string $scarfGrp = "";
    if ($useScarf) {
        string $cyl[] = `polyCylinder -r 1.4 -h 0.4 -name ($name + "_scarf")`;
        move -a 0 5.2 0 $cyl[0];

        string $tail1[] = `polyCube -w 4.2 -h 0.1 -d 1.4 -name ($name + "_scarfTail1")`;
        move -a 2.678 3.889 -0.777 $tail1[0];
        rotate -r 0 15 -40 $tail1[0];

        string $tail2[] = `polyCube -w 4.2 -h 0.1 -d 1.4 -name ($name + "_scarfTail2")`;
        move -a 2.5 4.0 -0.5 $tail2[0];
        rotate -r 0 -20 -30 $tail2[0];

        $scarfGrp = `group -n ($name + "_Scarf") $cyl[0] $tail1[0] $tail2[0]`;
    }

    // ---------------------------
    // Group All Snowman Parts
    // ---------------------------
    string $parts[];
    $parts[size($parts)] = $bottom[0];
    $parts[size($parts)] = $middle[0];
    $parts[size($parts)] = $head[0];
    $parts[size($parts)] = $coalGrp;
    if ($useScarf) $parts[size($parts)] = $scarfGrp;

    string $snowmanGrp = `group -n $name $parts`;

    // ---------------------------
    // Apply Scaling & Position
    // ---------------------------
    scale -r $scale $scale $scale $snowmanGrp;
    move -a $posX $posY $posZ $snowmanGrp;

    return $snowmanGrp;
}

/* ============================
   Example Usage
   ============================ */
makeSnowman("Snowy1", 1.0, 1, 0, 0, 0);   // Normal w/ scarf
makeSnowman("Snowy2", 0.7, 0, 5, 0, 0);   // Small no scarf
makeSnowman("Snowy3", 1.5, 1, -5, 0, 0);  // Large w/ scarf
