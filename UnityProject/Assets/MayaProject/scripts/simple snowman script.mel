// Create spheres with long-form flags
polySphere -name "snowman_bottom" -radius 3;
polySphere -name "snowman_middle" -radius 2;
polySphere -name "snowman_head"   -radius 1.3;

// Move spheres into position using long-form translate flags
move -relative -x 0 -y 0   -z 0 "snowman_bottom";
move -relative -x 0 -y 3.5 -z 0 "snowman_middle";
move -relative -x 0 -y 6   -z 0 "snowman_head";

// Create scarf as a cylinder with long-form flags
polyCylinder -name "snowman_scarf" -radius 1.4 -height 0.4;

//move scarf using long-form flags
move   -relative -x 0  -y 5.213 -z 0 "snowman_scarf";

// Create scarf tail as a cube with long-form flags
polyCube -name "snowman_scarfTail" -width 4.2 -height 0.1 -depth 1.4;

// Create second scarf tail as a cube
polyCube -name "snowman_scarfTail2" -width 4.2 -height 0.1 -depth 1.4;

// Move and rotate it slightly differently
move   -relative -x 2.5 -y 3.8 -z -0.9 "snowman_scarfTail2";
rotate -relative -x 0   -y 20   -z -50 "snowman_scarfTail2";


// Move and rotate scarf tail using long-form flags
move   -relative -x 2.678 -y 3.889 -z -0.777 "snowman_scarfTail";
rotate -relative -x 0     -y 15    -z -40 "snowman_scarfTail";

// --- Loop to create 9 small spheres for snowman eyes and mouth --- //
for ($i = 0; $i < 9; $i++) {
    
    // Create a small sphere
    string $coal[] = `polySphere 
        -radius 0.2 
        -subdivisionsX 8 
        -subdivisionsY 8`;
    
    // Make sure it’s visible in the viewport
    setAttr ($coal[0] + ".visibility") 1;

    // Position them on the head
    if ($i == 0) move -absolute -x -0.4 -y 6.8 -z 1.0 $coal[0];  // left eye
    if ($i == 1) move -absolute -x 0.4  -y 6.8 -z 1.0 $coal[0];  // right eye
    if ($i == 2) move -absolute -x -0.8 -y 6.2 -z 0.7 $coal[0];  // left mouth
    if ($i == 3) move -absolute -x -0.4 -y 6.1 -z 0.8 $coal[0];  // mouth
    if ($i == 4) move -absolute -x 0.0  -y 6.0 -z 0.8 $coal[0];  // mouth
    if ($i == 5) move -absolute -x 0.4  -y 6.1 -z 0.8 $coal[0];  // mouth
    if ($i == 6) move -absolute -x 0.8  -y 6.2 -z 0.7 $coal[0];  // right mouth
    if ($i == 7) move -absolute -x -0.2 -y 6.05 -z 0.6 $coal[0]; // middle mouth
    if ($i == 8) move -absolute -x 0.2  -y 6.05 -z 0.6 $coal[0]; // middle mouth
}
select -tgl pSphere9 pSphere3 pSphere8 pSphere7 pSphere4 pSphere5 pSphere6 ;
move -r 0 0 0.66454 ;
move -r 0 -0.427991 0 ;
move -r 0 0 -0.262203 ;

// Create snowman nose as a cone
polyCone -name "snowman_nose" -radius 0.2 -height 1;

// Move it to the front of the head (slightly more forward on Z)
move -absolute -x 0 -y 6 -z 1.5 "snowman_nose";

// Rotate so it sticks straight out (90 degrees instead of -90)
rotate -absolute -x 90 -y 0 -z 0 "snowman_nose";

// Select all objects we’ve created
select -r "snowman_bottom" "snowman_middle" "snowman_head" "snowman_scarf" "snowman_scarfTail" "snowman_scarfTail2" "snowman_nose";

// Add all the small coal spheres (eyes/mouth)
string $coalObjects[] = `ls "pSphere*"`;  // assumes your coal spheres start with pSphere
select -add $coalObjects;

// Group them all under one group
group -name "snowman";

// Move the entire snowman group up by 3 units
select -r snowman;
move -relative 0 3 0;