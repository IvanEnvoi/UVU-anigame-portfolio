// Procedure to build a scalable snowman
proc string makeSnowman(string $name, float $scale, int $useScarf) {
    // --- Body spheres --- //
    string $bottom[] = `polySphere -name ($name + "_bottom") -radius 3`;
    string $middle[] = `polySphere -name ($name + "_middle") -radius 2`;
    string $head[]   = `polySphere -name ($name + "_head")   -radius 1.3`;

    // Position them
    move -r 0 0   0 $bottom[0];
    move -r 0 3.5 0 $middle[0];
    move -r 0 6   0 $head[0];

    // Collect parts
    string $parts[] = {$bottom[0], $middle[0], $head[0]};

    // --- Face (eyes + mouth) --- //
    string $coalFace[];
    
    // Left eye
    string $eyeL[] = `polySphere -radius 0.2 -subdivisionsX 8 -subdivisionsY 8`;
    move -r -0.4 6.8 1.0 $eyeL[0];  // positioned relative to head
    $coalFace[size($coalFace)] = $eyeL[0];
    
    // Right eye
    string $eyeR[] = `polySphere -radius 0.2 -subdivisionsX 8 -subdivisionsY 8`;
    move -r 0.4 6.8 1.0 $eyeR[0];
    $coalFace[size($coalFace)] = $eyeR[0];
    
    // Mouth (5 pieces)
    string $m1[] = `polySphere -radius 0.16 -subdivisionsX 8 -subdivisionsY 8`;
    move -r -0.8 6.2 0.7 $m1[0];
    $coalFace[size($coalFace)] = $m1[0];
    
    string $m2[] = `polySphere -radius 0.16 -subdivisionsX 8 -subdivisionsY 8`;
    move -r -0.4 6.1 0.8 $m2[0];
    $coalFace[size($coalFace)] = $m2[0];
    
    string $m3[] = `polySphere -radius 0.16 -subdivisionsX 8 -subdivisionsY 8`;
    move -r 0.0 6.0 0.8 $m3[0];
    $coalFace[size($coalFace)] = $m3[0];
    
    string $m4[] = `polySphere -radius 0.16 -subdivisionsX 8 -subdivisionsY 8`;
    move -r 0.4 6.1 0.8 $m4[0];
    $coalFace[size($coalFace)] = $m4[0];
    
    string $m5[] = `polySphere -radius 0.16 -subdivisionsX 8 -subdivisionsY 8`;
    move -r 0.8 6.2 0.7 $m5[0];
    $coalFace[size($coalFace)] = $m5[0];

    // Group face
    string $coalGroup = `group -name ($name + "_coalFace") $coalFace`;
    $parts[size($parts)] = $coalGroup;

    // --- Optional Scarf --- //
    if ($useScarf) {
        string $scarf[] = `polyCylinder -name ($name + "_scarf") -radius 1.4 -height 0.4`;
        move -r 0 5.213 0 $scarf[0];

        string $tail1[] = `polyCube -name ($name + "_scarfTail1") -w 4.2 -h 0.1 -d 1.4`;
        move -r 2.678 3.889 -0.777 $tail1[0];
        rotate -r 0 15 -40 $tail1[0];

        string $tail2[] = `polyCube -name ($name + "_scarfTail2") -w 4.2 -h 0.1 -d 1.4`;
        move -r 2.5 3.6 -0.9 $tail2[0];
        rotate -r 0 -20 -30 $tail2[0];

        $parts[size($parts)] = $scarf[0];
        $parts[size($parts)] = $tail1[0];
        $parts[size($parts)] = $tail2[0];
    }

    // Group all
    string $snowmanGrp = `group -name $name $parts`;

    // Apply uniform scale
    scale $scale $scale $scale $snowmanGrp;

    return $snowmanGrp;
}

