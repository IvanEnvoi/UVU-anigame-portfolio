
global proc string makeSnowman(string $name, float $scale, int $useScarf, float $posX, float $posY, float $posZ) {
    
    // --- Body ---
    string $bottom[] = `polySphere -r 3 -name ($name + "_bottom")`;
    string $middle[] = `polySphere -r 2 -name ($name + "_middle")`;
    string $head[]   = `polySphere -r 1.3 -name ($name + "_head")`;

    move -r 0 0   0 $bottom[0];
    move -r 0 3.5 0 $middle[0];
    move -r 0 6   0 $head[0];

    // --- Coal face (eyes + mouth) ---
    string $coalGroup = `group -em -name ($name + "_coalFace")`;
    for ($i = 0; $i < 7; $i++) {
        string $coal[] = `polySphere -r 1 -name ($name + "_coal_" + $i)`;
        float $scale = ($i < 2) ? 0.2 : 0.16;
        setAttr ($coal[0] + ".scaleX") $scale;
        setAttr ($coal[0] + ".scaleY") $scale;
        setAttr ($coal[0] + ".scaleZ") $scale;

        // Position forward by head radius
        float $zOffset = 1.3;  

        if ($i == 0) move -a -x -0.4 -y 6.8 -z $zOffset $coal[0];
        if ($i == 1) move -a -x  0.4 -y 6.8 -z $zOffset $coal[0];
        if ($i == 2) move -a -x -0.8 -y 6.2 -z 1.0 $coal[0];
        if ($i == 3) move -a -x -0.4 -y 6.1 -z 1.0 $coal[0];
        if ($i == 4) move -a -x  0.0 -y 6.0 -z 1.0 $coal[0];
        if ($i == 5) move -a -x  0.4 -y 6.1 -z 1.0 $coal[0];
        if ($i == 6) move -a -x  0.8 -y 6.2 -z 1.0 $coal[0];

        parent $coal[0] $coalGroup;
    }

    // --- Optional scarf ---
    string $parts[] = {$bottom[0], $middle[0], $head[0], $coalGroup};
    if ($useScarf) {
        string $scarf[] = `polyCylinder -r 1.4 -h 0.4 -name ($name + "_scarf")`;
        move -r 0 5.213 0 $scarf[0];

        string $tail1[] = `polyCube -w 4.2 -h 0.1 -d 1.4 -name ($name + "_scarfTail1")`;
        move -r 2.678 3.889 -0.777 $tail1[0];
        rotate -r 0 15 -40 $tail1[0];

        string $tail2[] = `polyCube -w 4.2 -h 0.1 -d 1.4 -name ($name + "_scarfTail2")`;
        move -r 2.0 3.5 -1.2 $tail2[0];
        rotate -r 0 5 -20 $tail2[0];

        string $scarfGrp = `group -name ($name + "_scarf_grp") $scarf[0] $tail1[0] $tail2[0]`;
        $parts[size($parts)] = $scarfGrp;
    }

    // --- Group everything ---
    string $snowman = `group -name $name $parts`;

    // --- Scale whole snowman ---
    scale -r $scale $scale $scale $snowman;

    // --- Position snowman ---
    move -a $posX $posY $posZ $snowman;

    return $snowman;
}

//examples of call being made 
//makeSnowman("name",float for size, 0 or 1 for scarf, posionX, positionY, positionZ);
makeSnowman("snowman1", 1.0, 1, 0, 0, 0);     // at origin
makeSnowman("snowman2", 0.7, 0, 5, 0, 0);     // smaller, no scarf, moved right
makeSnowman("snowman3", 1.5, 1, -5, 0, 3);    // larger, with scarf, moved left + forward
makeSnowman("cutie", 5, 1, 20, 20,20);        // big, with scarf, moved off to the side and up
makeSnowman("lil_shit", 0.2, 1, 0, 0, 0);     // lil tiny one with scarf ofc

